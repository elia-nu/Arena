# Frontend API base URL (used by Vite build). Set in Vercel to your deployed backend URL.
# Example: https://api.leskickit.com or https://your-app.onrender.com
VITE_API_URL=

# TikTok API Configuration
# Get these credentials from https://developers.tiktok.com/
VITE_TIKTOK_CLIENT_KEY=your_client_key_here
VITE_TIKTOK_CLIENT_SECRET=your_client_secret_here

# Server: Twilio SMS (team member invites, etc.)
TWILIO_ACCOUNT_SID=AC0b2749746210d940852e505dec8ca70c
TWILIO_AUTH_TOKEN=8f4021e40e86abf57996477a9b59b0d6
TWILIO_PHONE_NUMBER=+12762462065
# ISO country code for parsing local numbers (libphonenumber), e.g. US, ET, GB
DEFAULT_PHONE_REGION=ET
